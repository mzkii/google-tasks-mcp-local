# Example config for the Slack -> Google Tasks automation.
# Copy this file to a private place outside this repo and fill in your values.
# This file is sourced by bash, so quote values that contain spaces.

# Task list that receives the tasks (the id returned by list_task_lists)
TASK_LIST_ID=<task list id from list_task_lists>

# What to look for: mentions to me, DMs to me, updates in threads I took part in that imply a task for me
TARGETS="mentions,dms,threads"

# How far back to search on each run
LOOKBACK_HOURS=24

# Weekday(1=Mon..7=Sun, ranges or lists)@HH:MM, space separated
SCHEDULE="1-5@09:00 1-5@18:00"

# Read-only tools of the claude.ai Slack connector. Never include send/schedule/create tools.
SLACK_READ_TOOLS="mcp__claude_ai_Slack__slack_search_public_and_private mcp__claude_ai_Slack__slack_read_channel mcp__claude_ai_Slack__slack_read_thread mcp__claude_ai_Slack__slack_search_users mcp__claude_ai_Slack__slack_read_user_profile"

# Optional. GitHub user/org to read (PRs and issues involving me, review requests). Empty = GitHub disabled.
# run.sh fetches it with read-only `gh` commands (needs `gh auth login`); the model gets no GitHub tools.
# Uses LOOKBACK_HOURS for the period.
GITHUB_OWNER=

# Optional. Empty = CLI default model
MODEL=

# Optional. google-tasks-mcp profile to use (default: default)
#GOOGLE_TASKS_PROFILE=default

# Optional free text appended to the prompt, e.g. language or which workspace
EXTRA_INSTRUCTIONS=""
